DISCORD_TOKEN=your_discord_bot_token_here
# Optional: set to the club server ID for immediate guild command registration.
# Leave blank to register commands globally instead.
GUILD_ID=your_discord_server_id_here
SPREADSHEET_ID=your_google_sheet_id_here
REMINDER_CHANNEL_ID=your_reminder_channel_id_here
OFFICER_ROLE_ID=your_officer_role_id_here
# Use only the ID between /d/ and /edit in the spreadsheet URL.
# Google credentials are resolved relative to the repo unless an absolute path is used.
GOOGLE_CREDENTIALS_FILE=service_account.json
LOG_LEVEL=INFO
